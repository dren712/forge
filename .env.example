# TensorMux Inference Partner
TENSORMUX_API_KEY=tmx_your_api_key_here
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_MODEL=glm-4-7-flash

# Database Configuration (SQLite local default)
DATABASE_URL=sqlite+aiosqlite:///forge.db

# Environment & Limits
FORGE_ENV=development
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=30
MAX_AGENT_RUNTIME_SECONDS=180
MAX_MODEL_RETRIES=2
